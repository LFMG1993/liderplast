{
  "name": "liderplast-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace=app-react",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "npm-run-all --parallel dev:*",
    "build": "npm run build --workspace=app-react"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}